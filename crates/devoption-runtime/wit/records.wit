package devoption:app@0.1.0;

/// One operator-selected append-only collection. No SQL, reads or destinations.
interface records {
    enum write-outcome { created, replayed }
    enum write-error { invalid, conflict, unavailable, denied }
    /// Canonical lowercase UUID retry ID and a bounded JSON object of strings/null.
    /// Success means PostgreSQL acknowledged COMMIT; unavailable may be ambiguous.
    append: func(id: string, payload: string) -> result<write-outcome, write-error>;
}

/// Separately granted exact-ID lookup. No listing, SQL or destination selection.
interface record-lookup {
    enum read-error { invalid, unavailable, denied }
    /// Missing rows return none, never an error masquerading as empty storage.
    get: func(id: string) -> result<option<string>, read-error>;
}

world record-imports { import records; }
world record-access-imports { import records; import record-lookup; }

/// A durable JSON delivery to one operator-selected HTTPS integration.
interface delivery-jobs {
    enum enqueue-outcome { accepted, replayed }
    enum enqueue-error { invalid, conflict, unavailable, denied }
    /// Delay is bounded to 0..3600 seconds; no caller-selected destination.
    enqueue: func(id: string, payload: string, delay-seconds: u32) -> result<enqueue-outcome, enqueue-error>;
}
world delivery-imports { import records; import delivery-jobs; }
