[Unit]
Description=DevOption platform behind local HTTPS proxy
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=devoption
Group=devoption
WorkingDirectory=/var/lib/devoption
ExecStartPre=/usr/bin/test -s /var/lib/devoption/data/owner.bin
ExecStart=/opt/devoption/devoption serve --port 3000 --data-dir /var/lib/devoption/data --repository-root /var/lib/devoption/repositories --public-origin https://platform.example.com
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/devoption
RestrictSUIDSGID=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
